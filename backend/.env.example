# Server Configuration
PORT=5000

# Supabase PostgreSQL Configuration
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Supabase REST / Storage (Optional if using direct SQL mostly)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# DokGuru AI Settings
DOKGURU_URL=http://localhost:8000

# JWT Secret (for authentication)
# Generate a new one in production: openssl rand -hex 32
SECRET_KEY=your_jwt_secret_key_here

# Frontend URLs for CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
